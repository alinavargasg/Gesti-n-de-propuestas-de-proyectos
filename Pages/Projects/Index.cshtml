@page
@model AuthenticationModule.Pages.Proyectos.IndexModel
@{
    ViewData["Title"] = "Listado de Proyectos";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2 class="fw-bold text-primary"><i class="bi bi-folder-fill me-2"></i>Proyectos Académicos</h2>
    <div>
        <a asp-page-handler="DescargarPdf" class="btn btn-outline-danger me-2">
            <i class="bi bi-file-earmark-pdf"></i> PDF
        </a>
        <a asp-page="Create" class="btn btn-success">
            <i class="bi bi-plus-lg"></i> Nuevo Proyecto
        </a>
    </div>
</div>

<div class="card">
    <div class="card-body p-0">
        <table class="table table-hover mb-0">
            <thead class="table-light">
                <tr>
                    <th class="ps-4">ID</th>
                    <th>Título</th>
                    <th>Tipo</th>
                    <th>Fecha Creación</th>
                    <th class="text-end pe-4">Acciones</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var p in Model.Proyectos)
                {
                    <tr>
                        <td class="ps-4 text-muted">#@p.Id</td>
                        <td class="fw-semibold">@p.Titulo</td>
                        <td>
                            @if (p.TipoProyecto == "Sociocomunitario")
                            {
                                <span class="badge rounded-pill bg-info text-dark">Sociocomunitario</span>
                            }
                            else
                            {
                                <span class="badge rounded-pill bg-warning text-dark">Emprendimiento</span>
                            }
                        </td>
                        <td>@p.CreatedAt.ToLocalTime().ToString("dd/MM/yyyy")</td>
                        <td class="text-end pe-4">
                            <a asp-page="./Details" asp-route-id="@p.Id" class="btn btn-sm btn-outline-primary" title="Ver detalles">
                                <i class="bi bi-eye"></i> Ver
                            </a>
                            <a asp-page="./Delete" asp-route-id="@p.Id" class="btn btn-sm btn-outline-danger ms-1" title="Eliminar">
                                <i class="bi bi-trash"></i>
                            </a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>