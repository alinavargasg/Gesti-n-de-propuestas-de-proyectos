@page "{id:int}"
@model AuthenticationModule.Pages.Proyectos.AsignarEstudiantesModel
@{
    ViewData["Title"] = "Asignar Estudiantes";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h2>Gestionar Estudiantes</h2>
    <a asp-page="./Details" asp-route-id="@Model.Proyecto.Id" class="btn btn-secondary">
        ← Volver a Detalles
    </a>
</div>

<h5 class="text-muted">Proyecto: @Model.Proyecto.Titulo</h5>
<hr />

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success alert-dismissible fade show">
        @TempData["SuccessMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

<div class="row">
    <!-- Formulario para agregar -->
    <div class="col-md-5">
        <div class="card shadow-sm">
            <div class="card-header bg-primary text-white">
                Asignar Nuevo Estudiante
            </div>
            <div class="card-body">
                @if (Model.EstudiantesDisponibles.Any())
                {
                    <form method="post">
                        <div asp-validation-summary="ModelOnly" class="text-danger"></div>

                        <div class="mb-3">
                            <label asp-for="Input.EstudianteId" class="form-label fw-bold"></label>
                            <select asp-for="Input.EstudianteId"
                                    asp-items="Model.EstudiantesDisponibles"
                                    class="form-select">
                                <option value="">-- Seleccione un estudiante libre --</option>
                            </select>
                            <span asp-validation-for="Input.EstudianteId" class="text-danger"></span>
                        </div>

                        <button type="submit" class="btn btn-success w-100">
                            ➕ Asignar al Proyecto
                        </button>
                    </form>
                }
                else
                {
                    <div class="alert alert-warning mb-0">
                        No hay estudiantes disponibles. Todos están asignados a otros proyectos o no existen.
                    </div>
                }
            </div>
        </div>
    </div>

    <!-- Lista actual de estudiantes -->
    <div class="col-md-7">
        <div class="card shadow-sm">
            <div class="card-header bg-dark text-white d-flex justify-content-between">
                <span>Estudiantes Asignados</span>
                <span class="badge bg-light text-dark">@Model.Proyecto.Estudiantes.Count</span>
            </div>
            <ul class="list-group list-group-flush">
                @if (Model.Proyecto.Estudiantes.Any())
                {
                    @foreach (var est in Model.Proyecto.Estudiantes)
                    {
                        <li class="list-group-item d-flex justify-content-between align-items-center">
                            <div>
                                <strong>@est.NombreCompleto</strong>
                                <br />
                                <small class="text-muted">@est.Curso</small>
                            </div>
                            <!-- Aquí podrías agregar un botón para desasignar si lo deseas -->
                        </li>
                    }
                }
                else
                {
                    <li class="list-group-item text-muted text-center py-4">
                        No hay estudiantes asignados a este proyecto aún.
                    </li>
                }
            </ul>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}